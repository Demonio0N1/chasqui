# Circularly polarized Alfven wave, oblique in x-y, extruded in z (3D CT path exercised).
[mesh]
nx1 = 32
nx2 = 32
nx3 = 8
x1min = 0.0
x1max = 1.4142135623730951
x2min = 0.0
x2max = 1.4142135623730951
x3min = 0.0
x3max = 0.35355339059327373

[time]
integrator = rk3
cfl = 0.3
tlim = 1.0

[mhd]
gamma = 1.6666666666666667
reconstruct = ppm
rsolver = hlld

[problem]
name = cpaw
dens = 1.0
pres = 0.1
b_par = 1.0
amp = 0.1
lambda = 1.0
angle = 45.0

[output]
basename = cpaw3d
hst_dt = 0.25
compute_error = true
